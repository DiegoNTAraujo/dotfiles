[global]
font = JetBrainsMono Nerd Font 12

follow = mouse
origin = top-right

width = (0, 500)
height = (0, 100)
offset = (20, 20)

gap_size = 5
frame_width = 2
corner_radius = 10

[urgency_low]
background = "#1a1b26"
foreground = "#c0caf5"
frame_color = "#c0caf5"
timeout = 5

[urgency_normal]
background = "#1a1b26"
foreground = "#c0caf5"
frame_color = "#c0caf5"
timeout = 5

[urgency_critical]
background = "#1a1b26"
foreground = "#c0caf5"
frame_color = "#f7768e"
timeout = 10